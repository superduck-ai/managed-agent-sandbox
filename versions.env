# Sandbox 镜像可执行合同的唯一值来源。
#
# 布局:
#   * 构建矩阵         - 本仓库可以产出哪些架构
#   * 共享值            - 所有架构都相同的值
#   * 按架构区分的值    - 每个架构一条 <NAME>_<ARCH> 条目，列在 SANDBOX_ARCH_VARS 中
#
# SANDBOX_ARCH_VARS 是架构相关变量名的权威列表。
# 构建 wrapper 和镜像内 verifier 都从这个列表把 <NAME>_<ARCH> 解析为 <NAME>，
# 所以一个值不可能在构建时按架构区分而在运行时架构无关。
# 新增架构只需修改本文件。
#
# 本文件会原样复制到镜像内 /etc/oma-sandbox-versions.env。

### 构建矩阵 ###

SANDBOX_PLATFORMS="linux/amd64 linux/arm64"
SANDBOX_ARCH_VARS="UNAME_MACHINE UBUNTU_DIGEST APT_RUNTIME_MIRROR ENVD_ARCH ENVD_SHA256 NODE_ARCH NODE_SHA256 GO_ARCH GO_SHA256 JAVA_ARCH JAVA_ARCHIVE JAVA_SHA256 BUN_ASSET BUN_SHA256 RUST_TARGET RUST_SHA256 UV_TARGET UV_SHA256 DOCKER_CLI_ARCH DOCKER_CLI_SHA256 CLAUDE_NPM_PACKAGE CLAUDE_SHA256 CLAUDE_PATCHED_SHA256 ENVIRONMENT_MANAGER_IMAGE_DIGEST ENVIRONMENT_MANAGER_SHA256 RCLONE_FILESTORE_IMAGE_DIGEST RCLONE_FILESTORE_SHA256"
TARGET_IMAGE_SIZE_BYTES=3221225472

### 共享基础与供应链 ###

UBUNTU_RELEASE_TAG=noble-20260610
UBUNTU_SNAPSHOT_TIMESTAMP=20260717T000000Z
CA_BUNDLE_URL=https://curl.se/ca/cacert-2026-07-16.pem
CA_BUNDLE_SHA256=sha256:3ff344e30b9b1ed2971044eabb438a08f2e2245ddb5f8ab1a3ad8b63ab4eaf91
RUNTIME_REVISION=2026-08-20
CODEX_UNIVERSAL_RECIPE_REVISION=47f4f0eb5337083e2f610db0d15558932cb4901d
OMA_ARTIFACT_REGISTRY=registry.gz.cvte.cn/oma
ENVD_VERSION=0.5.13
ENVIRONMENT_MANAGER_REVISION=b0fb2dbd9576018635dafa76c9a348c1a8d44029
ENVIRONMENT_MANAGER_VERSION=0.1.0

### 共享运行时版本 ###

# Python、PHP、Ruby 从架构无关的源码归档构建，一个版本和一个校验和覆盖所有架构。
PYTHON_VERSION=3.13.14
PYTHON_SHA256=639e43243c620a308f968213df9e00f2f8f62332f7adbaa7a7eeb9783057c690
PHP_VERSION=8.5.8
PHP_SHA256=58910198d19e873048fe87cdfe16bc790025417ede3d1651bfa1c4b533d573f2
RUBY_VERSION=3.4.10
RUBY_SERIES=3.4
RUBY_SHA256=6f32ad662baafc228d12030dbcd284f83b034dd4337b300dc84ac74d11a1eb68
NODE_VERSION=24.18.0
GO_VERSION=1.26.5
JAVA_VERSION=25.0.3+9
JAVA_RELEASE_TAG=jdk-25.0.3%2B9
BUN_VERSION=1.3.14
RUST_VERSION=1.97.0
CLAUDE_VERSION=2.1.251

# Ubuntu 在固定 snapshot 中两种架构的 gcc-14 包版本相同，所以编译器坐标也是共享的。
GCC_VERSION=14.2.0
GCC_MAJOR=14
GCC_APT_VERSION=14.2.0-4ubuntu2~24.04.1

### 共享开发工具 ###

# Maven、Gradle、Composer、Yarn、pnpm 发布架构无关的归档，运行在固定的 JVM 或 Node.js 上。
UV_VERSION=0.7.13
YARN_VERSION=1.22.22
YARN_TARBALL_URL=https://registry.npmmirror.com/yarn/-/yarn-1.22.22.tgz
